<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:contentDescription="@string/app_name"
        android:layout_marginTop="100dp"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
        android:textColor="?android:attr/textColorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Material3.DisplayLarge"
        android:text="@string/timer_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/second_light" />

    <ImageView
        android:id="@+id/first_light"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:src="@drawable/stoplight_circle_48"
        android:importantForAccessibility="no"
        app:tint="@color/stoplightOff"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintBottom_toTopOf="@+id/begin_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/second_light"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <ImageView
        android:id="@+id/second_light"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:src="@drawable/stoplight_circle_48"
        android:importantForAccessibility="no"
        app:tint="@color/stoplightOff"
        app:layout_constraintTop_toTopOf="@+id/first_light"
        app:layout_constraintBottom_toBottomOf="@+id/first_light"
        app:layout_constraintStart_toEndOf="@+id/first_light"
        app:layout_constraintEnd_toStartOf="@id/third_light" />

    <ImageView
        android:id="@+id/third_light"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:src="@drawable/stoplight_circle_48"
        android:importantForAccessibility="no"
        app:tint="@color/stoplightOff"
        app:layout_constraintTop_toTopOf="@id/second_light"
        app:layout_constraintBottom_toBottomOf="@id/second_light"
        app:layout_constraintStart_toEndOf="@id/second_light"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/begin_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:minWidth="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/begin"
        android:textSize="20sp"
        android:backgroundTint="@color/button"/>


</androidx.constraintlayout.widget.ConstraintLayout>